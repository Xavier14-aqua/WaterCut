{
  "name": "watercut",
  "productName": "WaterCut",
  "version": "1.4.3",
  "private": true,
  "description": "A local-first storyboard workspace for video creators",
  "keywords": [],
  "license": "MIT",
  "author": "WaterCut Contributors",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "notices": "node scripts/generate-notices.mjs && node scripts/generate-build-resources.mjs",
    "prepackage": "npm run notices",
    "package": "electron-forge package",
    "premake": "npm run notices",
    "make": "electron-forge make",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/run-smoke-stage12.mjs",
    "audit:dist": "node scripts/audit-distribution.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@xyflow/react": "^13.0.1",
    "mediainfo.js": "0.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "^4.6.7"
  }
}
